
generator client {
  provider = "prisma-client-js"
  output   = "../backend/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ImageType {
  PRODUCT
  VARIANT
}

model Category {
  id          String     @id @default(uuid()) @db.Uuid
  name        String     @db.VarChar(120)
  slug        String     @unique @db.VarChar(140)
  description String?    @db.Text
  isActive    Boolean    @default(true)
  sortOrder   Int        @default(0)
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([isActive, sortOrder])
}

model Product {
  id               String        @id @default(uuid()) @db.Uuid
  categoryId       String?       @db.Uuid
  name             String        @db.VarChar(200)
  slug             String        @unique @db.VarChar(220)
  shortDescription String?       @db.VarChar(500)
  description      String?       @db.Text
  status           ProductStatus @default(DRAFT)
  isFeatured       Boolean       @default(false)
  seoTitle         String?       @db.VarChar(70)
  seoDescription   String?       @db.VarChar(170)
  category         Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants         ProductVariant[]
  images           ProductImage[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([categoryId])
  @@index([status, createdAt])
  @@index([isFeatured, status])
}

model ProductVariant {
  id                 String         @id @default(uuid()) @db.Uuid
  productId          String         @db.Uuid
  sku                String         @unique @db.VarChar(80)
  name               String         @db.VarChar(160)
  sizeValue          Decimal?       @db.Decimal(10, 3)
  sizeUnit           String?        @db.VarChar(20)
  weightGrams        Int?
  barcode            String?        @unique @db.VarChar(80)
  isDefault          Boolean        @default(false)
  isActive           Boolean        @default(true)
  stockQuantity      Int            @default(0)
  lowStockThreshold  Int            @default(5)

  product            Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  prices             VariantPrice[]
  images             ProductImage[]
  cartItems          CartItem[]
  orderItems          OrderItem[]

  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([productId, isActive])
}
model ProductImage {
  id        String         @id @default(uuid()) @db.Uuid
  productId String         @db.Uuid
  variantId String?        @db.Uuid
  type      ImageType      @default(PRODUCT)
  url       String         @db.VarChar(2048)
  altText   String?        @db.VarChar(255)
  sortOrder Int            @default(0)
  isPrimary Boolean        @default(false)
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@index([productId, sortOrder])
  @@index([variantId, sortOrder])
}

model VariantPrice {
  id          String         @id @default(uuid()) @db.Uuid
  variantId   String         @db.Uuid
  currency    String         @db.VarChar(3)
  amount      Int
  buyingPrice Int?
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([variantId, currency])
  @@index([currency])
}

enum UserRole {
  CUSTOMER
  ADMIN
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(255)
  passwordHash String   @db.VarChar(255)
  role         UserRole @default(CUSTOMER)
  isActive     Boolean  @default(true)

  orders       Order[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([role, isActive])
}

enum AdminRole {
  ADMIN
  SUPER_ADMIN
}

model AdminUser {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(320)
  passwordHash String    @db.VarChar(255)
  name         String    @db.VarChar(120)
  role         AdminRole @default(ADMIN)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([isActive])
}
model Cart {
  id        String     @id @default(uuid()) @db.Uuid
  tokenHash String     @unique @db.VarChar(64)
  currency  String     @default("USD") @db.VarChar(3)
  items     CartItem[]
  expiresAt DateTime
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([expiresAt])
}

model CartItem {
  id        String        @id @default(uuid()) @db.Uuid
  cartId    String        @db.Uuid
  variantId String        @db.Uuid
  quantity  Int
  cart      Cart          @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([cartId, variantId])
  @@index([variantId])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
}

enum PaymentProvider {
  STRIPE
}

model Order {
  id                    String        @id @default(uuid()) @db.Uuid
  orderNumber           String        @unique @db.VarChar(40)

  userId                String?       @db.Uuid
  user                  User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  email                 String        @db.VarChar(254)
  phone                 String?       @db.VarChar(30)

  currency              String        @db.VarChar(3)

  subtotal              Int
  shippingAmount        Int           @default(0)
  taxAmount             Int           @default(0)
  discountAmount        Int           @default(0)
  totalAmount           Int

  status                OrderStatus   @default(PENDING)
  paymentStatus         PaymentStatus @default(PENDING)

  shippingAddress       Json
  billingAddress        Json
  customerNote          String?       @db.VarChar(1000)

  items                 OrderItem[]
  payments              Payment[]

  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([userId, createdAt])
  @@index([email, createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
}

model OrderItem {
  id                    String   @id @default(uuid()) @db.Uuid
  orderId               String   @db.Uuid
  variantId             String   @db.Uuid

  productName           String   @db.VarChar(200)
  variantName           String   @db.VarChar(160)
  sku                   String   @db.VarChar(80)

  unitPrice             Int
  quantity              Int
  lineTotal             Int

  order                 Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  variant               ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  createdAt             DateTime @default(now())

  @@index([orderId])
  @@index([variantId])
}

model Payment {
  id                    String          @id @default(uuid()) @db.Uuid
  orderId               String          @db.Uuid
  provider              PaymentProvider
  providerPaymentId     String?         @unique @db.VarChar(255)

  amount                Int
  currency              String          @db.VarChar(3)
  status                PaymentStatus   @default(PENDING)

  idempotencyKey        String?         @unique @db.VarChar(255)
  failureCode           String?         @db.VarChar(100)

  order                 Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)

  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([orderId, createdAt])
  @@index([status, createdAt])
}
