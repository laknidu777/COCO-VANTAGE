# COCO-VANTAGE Environment Configuration Template
# Copy this file to .env at the repository root and fill in your actual values.

# Database Configuration (PostgreSQL)
# Format: postgresql://<username>:<password>@<host>:<port>/<database>?schema=<schema>
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/coco_vantage?schema=public"

# Application Server
NODE_ENV=development
PORT=4000

# Security & CORS
# Comma-separated list or single origin allowed to make cross-origin API requests
FRONTEND_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3000"

# API Configuration
API_PREFIX="api/v1"
SWAGGER_PATH="api/docs"
