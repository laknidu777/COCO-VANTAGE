# =============================================================================
# COCO-VANTAGE — Root Environment Configuration Template
# =============================================================================
# Copy this file to .env at the repository root and fill in your values.
# This file is the SINGLE SOURCE OF TRUTH for all development configuration.
# Docker Compose uses this file to interpolate variables and isolate them
# per service so frontend containers never receive backend secrets.
# =============================================================================


# -----------------------------------------------------------------------------
# APPLICATION RUNTIME & NETWORKING
# -----------------------------------------------------------------------------
# Runtime environment: development, production, test
# Consumer: Backend NestJS bootstrap & Storefront Next.js
NODE_ENV=development

# Backend listening port
# Consumer: Backend NestJS bootstrap (app.listen) & Docker Compose
PORT=4000

# Backend listening host (0.0.0.0 required for Docker container reachability)
# Consumer: Backend NestJS bootstrap (app.listen)
HOST=0.0.0.0


# -----------------------------------------------------------------------------
# DATABASE (PostgreSQL & Prisma)
# -----------------------------------------------------------------------------
# Primary connection string for Docker-based development.
# Uses Docker internal service hostname "database" and internal port 5432.
# Consumer: Backend Prisma client & Prisma CLI inside Docker container.
DATABASE_URL="postgresql://<DB_USER>:<DB_PASSWORD>@database:5432/<DB_NAME>"

# PostgreSQL container credentials
# Consumer: docker-compose.yml (database service environment & healthcheck)
DB_NAME=coco_vantage
DB_USER=coco_vantage
DB_PASSWORD=change_me

# NOTE on Host-Side Database Access:
# Port 5433 is mapped to the host (0.0.0.0:5433 -> 5432) to allow desktop GUI tools
# (e.g. TablePlus, DBeaver) or host CLI tools without port collision on default 5432.
# For host-side tools only, connect using:
#   postgresql://<DB_USER>:<DB_PASSWORD>@localhost:5433/<DB_NAME>


# -----------------------------------------------------------------------------
# BACKEND — API & SWAGGER
# -----------------------------------------------------------------------------
# Global API prefix for all endpoints except /health
# Consumer: Backend NestJS bootstrap (app.setGlobalPrefix)
API_PREFIX=api/v1

# Route path where Swagger OpenAPI documentation UI is served
# Consumer: Backend NestJS SwaggerModule.setup
SWAGGER_PATH=api/docs

# Enable or disable Swagger documentation UI (true/false)
# In production, Swagger is disabled by default unless explicitly set to 'true'.
# Consumer: Backend NestJS bootstrap
SWAGGER_ENABLED=true


# -----------------------------------------------------------------------------
# URLS & CORS CONFIGURATION
# -----------------------------------------------------------------------------
# Public storefront URL used by backend for Stripe checkout redirection
# Consumer: Backend CheckoutService (Stripe success_url and cancel_url)
STOREFRONT_URL=http://localhost:3000

# Storefront origin used for backend CORS validation
# Consumer: Backend NestJS bootstrap (app.enableCors)
FRONTEND_URL=http://localhost:3000

# Explicit comma-separated allowed CORS origins for browser cross-origin requests
# Consumer: Backend NestJS bootstrap (app.enableCors)
CORS_ORIGIN=http://localhost:3000

# Public API URL used by browser JavaScript (must be browser-reachable, NEVER internal hostname)
# Consumer: Storefront client-side React code (lib/api-client.ts)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Internal backend URL used by Next.js Node server inside Docker network
# Must use the Docker service hostname "backend" — NOT localhost.
# Consumer: Storefront server-side execution only (lib/api-client.ts)
INTERNAL_API_URL=http://backend:4000


# -----------------------------------------------------------------------------
# SECURITY & AUTHENTICATION (BACKEND ONLY — NEVER EXPOSE TO STOREFRONT)
# -----------------------------------------------------------------------------
# Secret key for signing and verifying JSON Web Tokens (min 32 characters in production)
# Consumer: Backend AuthModule, JwtStrategy, JwtModule
JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-characters


# -----------------------------------------------------------------------------
# STRIPE PAYMENTS (BACKEND ONLY — NEVER EXPOSE TO STOREFRONT)
# -----------------------------------------------------------------------------
# Stripe secret API key (starts with sk_test_ or sk_live_)
# Consumer: Backend StripeService & CheckoutService
STRIPE_SECRET_KEY=sk_test_placeholder

# Stripe webhook endpoint signing secret (starts with whsec_)
# Consumer: Backend Stripe webhook handler
STRIPE_WEBHOOK_SECRET=whsec_placeholder
